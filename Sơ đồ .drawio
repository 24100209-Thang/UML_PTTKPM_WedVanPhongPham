        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam dpi 170\nskinparam monochrome true\nskinparam defaultFontName Liberation Sans\nskinparam roundCorner 0\nskinparam shadowing false\nskinparam defaultFontSize 11\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam maxMessageSize 120\nskinparam wrapWidth 170\nskinparam sequence {\n}\nskinparam ParticipantPadding 30\nskinparam BoxPadding 10\nskinparam ParticipantBackgroundColor white\nskinparam ActorBackgroundColor white\nskinparam BoundaryBackgroundColor white\nskinparam ControlBackgroundColor white\nskinparam EntityBackgroundColor white\nskinparam GroupBackgroundColor white\nautonumber\nhide footbox\n\nactor \&quot;Khách hàng\&quot; as KH\nboundary \&quot;ManHinhDatHang\&quot; as UI\ncontrol \&quot;DonHangController\&quot; as CT\nentity \&quot;GioHang\&quot; as GH\nentity \&quot;SanPham\&quot; as SP\nentity \&quot;DonHang\&quot; as DH\nKH -&gt; UI ++ : Chọn \&quot;Đặt hàng\&quot;, nhập địa chỉ nhận hàng, chọn phương thức giao hàng và thanh toán\nUI -&gt; CT ++ : datHang(thongTinNhanHang, phuongThuc)\nCT -&gt; GH ++ : layChiTietGioHang(maKH)\nGH --&gt; CT -- : danhSachSanPham\nCT -&gt; SP ++ : kiemTraTonKho(danhSachSanPham)\nSP --&gt; CT -- : ketQua\nalt Có sản phẩm không đủ số lượng\n  CT --&gt; UI : Danh sách sản phẩm thiếu hàng\n  UI --&gt; KH : Thông báo, yêu cầu điều chỉnh giỏ hàng\nelse Đủ hàng\n  CT -&gt; DH ++ : taoDonHang(maKH, thongTinNhanHang, danhSachSanPham)\n  DH --&gt; CT -- : donHang (trạng thái \&quot;Chờ xử lý\&quot;)\n  CT -&gt; SP ++ : truTonKho(danhSachSanPham)\n  SP --&gt; CT -- : Đã cập nhật tồn kho\n  CT -&gt; GH ++ : xoaGioHang(maKH)\n  GH --&gt; CT -- : Đã xóa giỏ hàng\n  alt Thanh toán khi nhận hàng\n    CT --&gt; UI : Đặt hàng thành công\n    UI --&gt; KH : Hiển thị mã đơn hàng\n  else Thanh toán trực tuyến\n    CT --&gt; UI : Chuyển sang bước thanh toán\n    UI --&gt; KH : Chuyển đến trang thanh toán\n  end\nend\ndeactivate CT\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hd40aEydyesqh5e2qHZt-1">
