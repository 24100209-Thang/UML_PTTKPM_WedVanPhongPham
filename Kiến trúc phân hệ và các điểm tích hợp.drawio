        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam style strictuml\nhide circle\n\n&#39; ===== Tài khoản =====\nclass TaiKhoan {\n  maTK\n  email\n  matKhau\n  vaiTro\n  trangThai\n  soLanSaiDangNhap\n  khoaDenKhi\n  --\n  taoTaiKhoan(thongTin)\n  kiemTraTonTai(email)\n  timTheoEmail(email)\n  doiMatKhau(matKhauMoi)\n  ghiNhanDangNhapSai()\n  khoaTaiKhoan(thoiGian)\n  kiemTraKhoa()\n  datLaiSoLanSai()\n}\n\nclass KhachHang {\n  maKH\n  hoTen\n  soDienThoai\n  diaChi\n  --\n  capNhatThongTin()\n  xemLichSuDonHang()\n  themYeuThich(maSP)\n  boYeuThich(maSP)\n  layDanhSachYeuThich()\n}\n\nclass QuanTriVien {\n  maQTV\n  hoTen\n  --\n  quanLySanPham()\n  quanLyDonHang()\n  quanLyKhachHang()\n}\n\n&#39; ===== Giỏ hàng =====\nclass GioHang {\n  maGH\n  tongTien\n  --\n  layGioHang(maKH)\n  layChiTietGioHang(maKH)\n  capNhatSoLuong(maSP, soLuong)\n  xoaSanPham(maSP)\n  tinhTongTien()\n  xoaGioHang(maKH)\n}\n\nclass ChiTietGioHang {\n  soLuong\n  thanhTien\n  --\n  themHoacCapNhat(maSP, soLuong)\n  tinhThanhTien()\n}\n\n&#39; ===== Đơn hàng =====\nclass DonHang {\n  maDH\n  ngayDat\n  tongTien\n  diaChiNhan\n  sdtNhan\n  phuongThucThanhToan\n  trangThai\n  --\n  taoDonHang(maKH, thongTinNhanHang, dsSanPham)\n  layThongTin(maDH)\n  layThongTinGiaoNhan()\n  tinhTongTien()\n  capNhatTrangThai(trangThai)\n  huyDonHang()\n}\n\nclass ChiTietDonHang {\n  soLuong\n  donGia\n  thanhTien\n  --\n  taoChiTiet(dsSanPham)\n  tinhThanhTien()\n}\n\nclass ThanhToan {\n  maTT\n  phuongThuc\n  soTien\n  thoiGian\n  trangThai\n  --\n  taoGiaoDich(maDH, soTien)\n  capNhatTrangThai(trangThai)\n  kiemTraKetQua()\n}\n\nclass VanChuyen {\n  maVanDon\n  donViVanChuyen\n  trangThaiGiao\n  ngayGiao\n  --\n  tiepNhan(maDH)\n  capNhatTrangThai(trangThaiGiao)\n  xacNhanGiaoHang()\n}\n\n&#39; ===== Yêu thích =====\nclass YeuThich {\n  maKH\n  maSP\n  ngayThem\n  --\n  taoYeuThich(maKH, maSP)\n  xoaYeuThich(maKH, maSP)\n  kiemTraTonTai(maKH, maSP)\n  layTheoKhachHang(maKH)\n}\n\n&#39; ===== Danh mục &amp; Sản phẩm =====\nclass DanhMuc {\n  maDanhMuc\n  tenDanhMuc\n  moTa\n  maDanhMucCha\n  --\n  themDanhMuc()\n  suaDanhMuc()\n  xoaDanhMuc()\n  layTatCa()\n  layDanhMucCon(maDanhMuc)\n}\n\nclass SanPham {\n  maSP\n  tenSP\n  giaBan\n  moTa\n  hinhAnh\n  soLuongTon\n  soLuongDaBan\n  trangThai\n  --\n  taoSanPham(thongTin)\n  suaSanPham()\n  xoaSanPham()\n  timKiem(tuKhoa, maDanhMuc)\n  layThongTin(maSP)\n  kiemTraTonKho(soLuong)\n  truTonKho(soLuong)\n  capNhatSoLuongDaBan(soLuong)\n}\n\n&#39; ===== Kế thừa =====\nTaiKhoan &lt;|-- KhachHang\nTaiKhoan &lt;|-- QuanTriVien\n\n&#39; ===== Quan hệ của KhachHang =====\nKhachHang \&quot;1\&quot; -- \&quot;1\&quot; GioHang : sở hữu\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang : đặt\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; YeuThich : yêu thích\n\n&#39; ===== Giỏ hàng =====\nGioHang \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietGioHang\n\n&#39; ===== Đơn hàng =====\nDonHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang\nDonHang \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : thanh toán bởi\nDonHang \&quot;1\&quot; -- \&quot;0..1\&quot; VanChuyen : giao bởi\n\n&#39; ===== Liên kết tới SanPham =====\nChiTietGioHang \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham\nChiTietDonHang \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham\nYeuThich \&quot;0..*\&quot; --&gt; \&quot;1\&quot; SanPham\n\n&#39; ===== Danh mục =====\nDanhMuc \&quot;1\&quot; o-- \&quot;0..*\&quot; SanPham : phân loại\nDanhMuc \&quot;0..1\&quot; -- \&quot;0..*\&quot; DanhMuc : danh mục cha\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="e_yfu9Kg6e13ePJPt7P6-1">
